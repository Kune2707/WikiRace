# Docker Compose configuration. Copy to .env; never commit real credentials.
DATABASE_NAME=wikirace
DATABASE_USER=wikirace
# Required: generate a unique password and retain it with the database volume.
DATABASE_PASSWORD=
FRONTEND_PORT=8080
# Optional: absolute browser-facing origin; default http://localhost:FRONTEND_PORT.
# PUBLIC_ORIGIN=http://localhost:8080
# Set your real contact/project identity before shared or deployed use.
# WIKIPEDIA_USER_AGENT=WikiRace/0.0.1 (your real project URL or contact email)
